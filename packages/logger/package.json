{
	"name": "@fxyz/logger",
	"version": "0.1.0",
	"description": "Structured logging for Node.js and the browser, built on Pino.",
	"license": "Apache-2.0",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"import": "./dist/browser.js",
			"require": "./dist/browser.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts src/browser.ts --format esm,cjs --dts",
		"clean": "rm -rf .turbo node_modules dist",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3"
	},
	"devDependencies": {
		"@types/node": "^22",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3"
	}
}
