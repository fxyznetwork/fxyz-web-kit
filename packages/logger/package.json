{
	"name": "@fxyz/logger",
	"version": "0.1.0",
	"description": "Structured logging for Node.js and the browser, built on Pino.",
	"license": "Apache-2.0",
	"author": "fxyz network",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fxyznetwork/fxyz-web-kit.git",
		"directory": "packages/logger"
	},
	"homepage": "https://github.com/fxyznetwork/fxyz-web-kit/tree/main/packages/logger#readme",
	"bugs": {
		"url": "https://github.com/fxyznetwork/fxyz-web-kit/issues"
	},
	"engines": {
		"node": ">=22"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"import": "./dist/browser.js",
			"require": "./dist/browser.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts src/browser.ts --format esm,cjs --dts",
		"clean": "rm -rf .turbo node_modules dist",
		"test": "NODE_ENV=test jest --passWithNoTests",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3"
	},
	"devDependencies": {
		"@jest/globals": "^30.4.1",
		"@swc/core": "^1.15.46",
		"@swc/jest": "^0.2.39",
		"@types/jest": "^30.0.0",
		"@types/node": "^26",
		"jest": "^30.4.2",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3"
	}
}
